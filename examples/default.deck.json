{
  "schemaVersion": 1,
  "defaultWorkspace": "editing",
  "workspaces": [
    {
      "id": "editing",
      "name": "Editing",
      "kind": "deck",
      "grid": { "rows": 3, "cols": 3 },
      "buttons": [
        {
          "id": "copy",
          "label": "Copy",
          "icon": "sf:doc.on.doc",
          "color": "#3B82F6",
          "action": { "type": "key", "key": "c", "modifiers": ["cmd"] },
          "position": { "row": 0, "col": 0 }
        },
        {
          "id": "paste",
          "label": "Paste",
          "icon": "sf:doc.on.clipboard",
          "color": "#3B82F6",
          "action": { "type": "key", "key": "v", "modifiers": ["cmd"] },
          "position": { "row": 0, "col": 1 }
        },
        {
          "id": "undo",
          "label": "Undo",
          "icon": "sf:arrow.uturn.backward",
          "color": "#F59E0B",
          "action": { "type": "key", "key": "z", "modifiers": ["cmd"] },
          "position": { "row": 0, "col": 2 }
        },
        {
          "id": "redo",
          "label": "Redo",
          "icon": "sf:arrow.uturn.forward",
          "color": "#F59E0B",
          "action": { "type": "key", "key": "z", "modifiers": ["cmd", "shift"] },
          "position": { "row": 1, "col": 2 }
        },
        {
          "id": "cmd-hold",
          "label": "Cmd (hold)",
          "icon": "sf:command",
          "color": "#6B7280",
          "action": { "type": "key", "key": "tab", "modifiers": ["cmd"], "behavior": "hold" },
          "position": { "row": 1, "col": 0 }
        },
        {
          "id": "spotlight",
          "label": "Spotlight",
          "icon": "sf:magnifyingglass",
          "color": "#10B981",
          "action": { "type": "key", "key": "space", "modifiers": ["cmd"] },
          "position": { "row": 1, "col": 1 }
        },
        {
          "id": "copy-paste",
          "label": "Duplicate",
          "icon": "sf:plus.square.on.square",
          "color": "#8B5CF6",
          "action": { "type": "macro", "macroId": "duplicate-selection" },
          "position": { "row": 2, "col": 0, "colSpan": 2 }
        },
        {
          "id": "to-mouse",
          "label": "Mouse",
          "icon": "sf:computermouse",
          "color": "#EF4444",
          "action": { "type": "workspace", "workspaceId": "pointer" },
          "position": { "row": 2, "col": 2 }
        }
      ]
    },
    {
      "id": "pointer",
      "name": "Pointer",
      "kind": "mouse"
    },
    {
      "id": "typing",
      "name": "Keyboard",
      "kind": "keyboard"
    }
  ],
  "macros": [
    {
      "id": "duplicate-selection",
      "label": "Duplicate selection",
      "steps": [
        { "action": { "type": "key", "key": "c", "modifiers": ["cmd"] }, "delayAfterMs": 60 },
        { "action": { "type": "key", "key": "arrowRight" }, "delayAfterMs": 60 },
        { "action": { "type": "key", "key": "return" }, "delayAfterMs": 30 },
        { "action": { "type": "key", "key": "v", "modifiers": ["cmd"] } }
      ]
    }
  ]
}

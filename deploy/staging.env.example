# Copy to deploy/staging.env and fill in. Never commit the real file.
COMPOSE_PROJECT_NAME=planner-staging
ENVIRONMENT=staging
WEB_PORT=3100
PUBLIC_URL=https://staging.planner.example.com
COOKIE_SECURE=true
# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
SECRET_KEY=
# Generate with:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
BACKUP_KEEP_DAYS=14
# Optional AI assistant (OpenRouter or any OpenAI-compatible service). Leave blank for the private built-in helper.
# Set AI_DPA_CONFIRMED=true only once a data-processing agreement with the provider is in place.
AI_API_KEY=
AI_MODEL=
AI_DPA_CONFIRMED=false
# Optional account linking. "none" = manual entry and CSV only.
AGGREGATION_PROVIDER=none
